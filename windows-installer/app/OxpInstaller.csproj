<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OxpInstaller</AssemblyName>
    <Version>1.0.6</Version>
    <AssemblyVersion>1.0.6.0</AssemblyVersion>
    <FileVersion>1.0.6.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PortableLauncherName Condition="'$(PortableLauncherName)' == ''">SteamOSInstaller.exe</PortableLauncherName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../components/release.json" LogicalName="OxpInstaller.release.json" />
    <EmbeddedResource Include="RestartToSteamOS.bat" LogicalName="OxpInstaller.RestartToSteamOS.bat" />
  </ItemGroup>
  <Target Name="CreatePortableLauncher" AfterTargets="Build" DependsOnTargets="_GetAppHostPaths">
    <CreateAppHost AppHostSourcePath="$(AppHostSourcePath)"
                   AppHostDestinationPath="$(MSBuildProjectDirectory)/../$(PortableLauncherName)"
                   AppBinaryName="app/bin/$(Configuration)/$(TargetFramework)/$(AssemblyName)$(TargetExt)"
                   IntermediateAssembly="@(IntermediateAssembly-&gt;'%(FullPath)')"
                   WindowsGraphicalUserInterface="true"
                   DotNetSearchLocations="AppRelative"
                   AppRelativeDotNet="../../../../runtime/dotnet" />
  </Target>
</Project>


